# Copy this file to .env for local testing.
# On Railway, you'll enter these same names/values under the "Variables" tab instead of a file.

# Login for the admin area (choose your own values - do not use these defaults on the live site)
ADMIN_USERNAME=principal
ADMIN_PASSWORD=changeme123

# A random string used to secure login sessions. Any long random text works.
SESSION_SECRET=please-change-this-to-something-random

# Provided automatically by Railway once you attach a PostgreSQL database to
# this service - you will not normally type this in yourself.
# DATABASE_URL=postgres://user:password@host:port/database

# Only set this to true if you connect to Railway's public/proxy database URL
# from outside Railway (e.g. testing from your own computer). Leave unset
# for the normal internal connection Railway uses between your app and database.
# PGSSL=true

# Where uploaded documents are stored on disk.
# Leave this unset for local testing. On Railway, once you attach a Volume,
# set this to the mount path you chose (commonly /data).
# DATA_DIR=/data
