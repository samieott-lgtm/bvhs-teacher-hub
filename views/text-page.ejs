<div class="page-header">
  <h1><%= page.title %></h1>
</div>

<section class="card accent-green">
  <% if (!page.body) { %>
    <p class="empty-note">This page hasn't been filled in yet. The principal can add content from the admin area.</p>
  <% } else { %>
    <p class="prose"><%= page.body %></p>
  <% } %>
</section>
